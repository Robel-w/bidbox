# OpenAI-compatible local or hosted open-weights endpoint.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
EVAL_RUNS=2
EVAL_CASE_TIMEOUT=240
BIDBOX_FILESYSTEM_MCP_VERSION=2025.1.14
COST_PER_1M_INPUT_TOKENS=0.0
COST_PER_1M_OUTPUT_TOKENS=0.0
# Per-tool-call timeout in seconds; each call gets one retry before a limitation is recorded.
TOOL_TIMEOUT_S=30
# Demo only: name of a tool that should time out once per run (e.g. benchmark_award). Leave empty normally.
DEMO_FAULT_TOOL=
