# OpenAI-compatible local or hosted open-weights endpoint.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
EVAL_RUNS=2
EVAL_CASE_TIMEOUT=240
BIDBOX_FILESYSTEM_MCP_VERSION=2025.1.14
# Unit economics (runs/<run_id>/run_metrics.json). Leave empty if unknown: costs then show "not configured".
# LLM prices in USD per 1M tokens.
LLM_PRICE_IN=
LLM_PRICE_OUT=
# USD per tool call, per SMS, per outcome.
TOOL_FEE_USD=
SMS_FEE_USD=
API_FEE_PER_OUTCOME_USD=
HOSTING_FEE_PER_OUTCOME_USD=
# Exchange rate used for KES figures; the rate is printed alongside every KES value.
USD_TO_KES=
# Per-tool-call timeout in seconds; each call gets one retry before a limitation is recorded.
TOOL_TIMEOUT_S=30
# Demo only: name of a tool that should time out once per run (e.g. benchmark_award). Leave empty normally.
DEMO_FAULT_TOOL=
