# Hosted OpenAI-compatible endpoint; LLM_API_KEY is a host secret, never a tracked value.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
# low is supported by both requested Groq models; empty omits the setting for Ollama.
LLM_REASONING_EFFORT=low
EVAL_RUNS=2
EVAL_CASE_TIMEOUT=240
BIDBOX_FILESYSTEM_MCP_VERSION=2025.1.14
# Unit economics (runs/<run_id>/run_metrics.json). Leave empty if unknown: costs then show "not configured".
# LLM prices in USD per 1M tokens.
LLM_PRICE_IN=
LLM_PRICE_OUT=
# The rates apply only to this exact model; date entered is YYYY-MM-DD, never auto-filled.
LLM_PRICE_MODEL=
LLM_PRICE_DATE=
# free or paid; empty means not configured. Free plan is not a zero list price.
LLM_PLAN=
# USD per tool call, per SMS, per outcome.
TOOL_FEE_USD=
SMS_FEE_USD=
API_FEE_PER_OUTCOME_USD=
HOSTING_FEE_PER_OUTCOME_USD=
# Exchange rate used for KES figures; the rate is printed alongside every KES value.
USD_TO_KES=
# Per-tool-call timeout in seconds; each call gets one retry before a limitation is recorded.
TOOL_TIMEOUT_S=30
# Demo only: name of a tool that should time out once per run (e.g. benchmark_award). Leave empty normally.
DEMO_FAULT_TOOL=
BIDBOX_DB_PATH=
# 1 loads only sandbox fixtures (origin sandbox, labelled SANDBOX) instead of the live DB. Empty normally.
BIDBOX_SANDBOX=
